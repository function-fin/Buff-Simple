local function fullResetAndCleanup()
	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
		end
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if rootPart then
			local existingSpin = rootPart:FindFirstChild("IY_SpinVelocity")
			if existingSpin then
				existingSpin:Destroy()
			end
		end
	end
	screenGui:Destroy()
	hudContainer:Destroy()
end

local function applySpinPhysics(active)
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local existingSpin = rootPart:FindFirstChild("IY_SpinVelocity")

	if active and spinVisible then
		if not existingSpin then
			local spinVelocity = Instance.new("BodyAngularVelocity")
			spinVelocity.Name = "IY_SpinVelocity"
			spinVelocity.MaxTorque = Vector3.new(0, math.huge, 0)
			spinVelocity.AngularVelocity = Vector3.new(0, customSpin, 0)
			spinVelocity.Parent = rootPart
		else
			existingSpin.AngularVelocity = Vector3.new(0, customSpin, 0)
		end
	else
		if existingSpin then
			existingSpin:Destroy()
		end
	end
end

