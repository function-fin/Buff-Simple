hudJumpBtn.MouseButton1Click:Connect(function()
	local character = player.Character
	if character and character:FindFirstChildOfClass("Humanoid") then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local oldJump = humanoid.JumpPower
		
		-- Aplica a força customizada apenas para este pulo específico
		humanoid.JumpPower = customJump
		humanoid.UseJumpPower = true
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		
		-- Restaura a força original para que o botão nativo do jogo não seja alterado
		task.delay(0.1, function()
			if humanoid and humanoid.Parent then
				humanoid.JumpPower = oldJump
			end
		end)
	end
end)

